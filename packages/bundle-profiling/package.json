{
  "name": "@spectrum-charts/bundle-profiling",
  "version": "0.0.0",
  "private": true,
  "description": "Internal tooling for measuring the true cold-consumer bundle cost of @spectrum-charts/react-spectrum-charts-s2, including its peer dependencies. Not published.",
  "scripts": {
    "profile": "webpack --config webpack.profile.config.js --json=dist/stats.json && node scripts/report.js",
    "profile:shared-react": "webpack --config webpack.profile-shared-react.config.js --json=dist-shared-react/stats.json && node scripts/report.js dist-shared-react",
    "analyze": "webpack-bundle-analyzer dist/stats.json dist"
  },
  "dependencies": {
    "@react-spectrum/s2": ">=1.0.0",
    "@spectrum-charts/react-spectrum-charts-s2": "0.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2"
  }
}
