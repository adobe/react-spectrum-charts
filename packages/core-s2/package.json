{
  "name": "@spectrum-charts/core-s2",
  "version": "0.9.0",
  "description": "Constants, locales, design tokens, and utilities for Spectrum 2 charts",
  "files": [
    "dist"
  ],
  "exports": {
    "./constants": {
      "types": "./dist/types/constants/index.d.ts",
      "default": "./dist/constants.js"
    },
    "./locales": {
      "types": "./dist/types/locales/index.d.ts",
      "default": "./dist/locales.js"
    },
    "./tokens": {
      "types": "./dist/types/tokens/index.d.ts",
      "default": "./dist/tokens.js"
    },
    "./utils": {
      "types": "./dist/types/utils/index.d.ts",
      "default": "./dist/utils.js"
    },
    "./package.json": "./package.json"
  },
  "author": "c-lamoureux",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/react-spectrum-charts.git"
  },
  "scripts": {
    "build": "echo 'S2 package - skipping default build. Use yarn build:s2 to build explicitly.'",
    "build:s2": "webpack --config ./webpack.config.js",
    "clean": "rm -rf dist",
    "pack-test": "yarn clean && yarn build:s2 && cross-env NODE_ENV=development npm pack",
    "pack": "cross-env NODE_ENV=production npm pack",
    "publish-package": "npm publish --access public --registry https://registry.npmjs.org"
  },
  "dependencies": {
    "vega": "^6.2.0"
  },
  "devDependencies": {
    "ts-loader": "^9.4.2",
    "typescript": "^5.4.5",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.1"
  }
}
