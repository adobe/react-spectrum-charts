{
  "name": "@spectrum-charts/react-spectrum-charts-s2",
  "version": "0.9.0",
  "description": "Declarative library for composing Spectrum 2 visualizations in React.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/@types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/@types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pre-alpha": {
      "types": "./dist/@types/pre-alpha/index.d.ts",
      "default": "./dist/pre-alpha/index.js"
    },
    "./ai-catalog": {
      "types": "./dist/@types/src/ai-catalog/index.d.ts",
      "default": "./dist/src/ai-catalog/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/src/VegaChart.js"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/@types/index.d.ts"
      ],
      "pre-alpha": [
        "./dist/@types/pre-alpha/index.d.ts"
      ],
      "ai-catalog": [
        "./dist/@types/src/ai-catalog/index.d.ts"
      ]
    }
  },
  "files": [
    "/dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adobe/react-spectrum-charts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "c-lamoureux",
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "echo 'This will run before build'",
    "build": "echo 'S2 package - skipping default build. Use yarn build:s2 to build explicitly.'",
    "build:s2": "rm -rf dist && rollup -c && tsc -p tsconfig.build.json && node ../../scripts/stripDeclarationCssImports.mjs dist/@types",
    "clean": "rm -rf dist",
    "g": "plop component",
    "generate": "plop component",
    "pack-test": "yarn clean && yarn build:s2 && cross-env NODE_ENV=development npm pack",
    "pack": "cross-env NODE_ENV=production npm pack",
    "sonar": "node ./scripts/runSonarOnBranch.js",
    "sonar-fork-pr": "node ./scripts/runSonarOnFork.js",
    "test": "cross-env TZ=UTC BABEL_ENV=test jest --config ../../jest.config.js",
    "watch": "cross-env TZ=UTC BABEL_ENV=test jest --config ../../jest.config.js --watch",
    "skulk": "yarn watch --silent",
    "publish-package": "npm publish --access public --registry https://registry.npmjs.org"
  },
  "dependencies": {
    "@internationalized/string": "^3.2.1",
    "@spectrum-charts/core-s2": "0.9.0",
    "@spectrum-charts/schemas": "^1.52.0",
    "@spectrum-charts/vega-spec-builder-s2": "0.9.0",
    "d3-array": "^3.2.4",
    "d3-format": "^3.1.0",
    "data-navigator": "^2.4.1",
    "deepmerge": ">= 4.0.0",
    "immer": ">= 9.0.0",
    "react-stately": "^3.46.0",
    "vega-embed": ">= 7.1.0",
    "vega-tooltip": ">= 1.1.0"
  },
  "peerDependencies": {
    "@react-spectrum/s2": ">=1.0.0",
    "react": ">= 19.0.0",
    "react-aria-components": "^1.14.0",
    "react-dom": ">= 19.0.0",
    "vega": "^6.2.0",
    "vega-lite": "^6.4.2"
  },
  "devDependencies": {
    "@internationalized/string-compiler": "^3.4.1"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "bugs": {
    "url": "https://github.com/adobe/react-spectrum-charts/issues"
  },
  "homepage": "https://github.com/adobe/react-spectrum-charts#readme",
  "keywords": [
    "Adobe",
    "AdobeAnalytics",
    "Analytics",
    "Data",
    "Viz",
    "React",
    "Spectrum",
    "Charts"
  ]
}
